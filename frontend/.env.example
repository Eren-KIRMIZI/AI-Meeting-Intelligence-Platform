# ---------------------------------------------------------------------------
# Nova — environment template
# Copy to `.env` (never commit `.env`). Values stay empty on purpose.
# ---------------------------------------------------------------------------

# Public browser-safe values (exposed to the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only — used by Vercel serverless functions.
# NEVER prefix these with VITE_ and never import them from src/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
VITE_APP_URL=
