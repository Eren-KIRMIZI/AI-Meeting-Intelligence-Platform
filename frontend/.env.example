# ---------------------------------------------------------------------------
# Nova — environment template
# Copy to `.env` (never commit `.env`). Values stay empty on purpose.
# ---------------------------------------------------------------------------

# Public browser-safe values (exposed to the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side only — used by Vercel serverless functions.
# NEVER prefix these with VITE_ and never import them from src/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — enables live transcript extraction in POST /api/meetings/analyze.
# Leave empty to keep the deterministic demo analyzer and the 503 provider gate.
# OpenAI-compatible base URL: use https://openrouter.ai/api/v1 for free models.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Comma-separated model fallbacks are tried when a free provider is throttled.
OPENAI_MODEL=google/gemma-4-31b-it:free

# Optional — LiveKit media for production Nova Live rooms.
# VITE_LIVEKIT_URL is public (wss://...); the key and secret stay server-side
# and are only read by POST /api/live/token. Demo mode uses a WebRTC mesh and
# does not need these values.
VITE_LIVEKIT_URL=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional
VITE_APP_URL=
